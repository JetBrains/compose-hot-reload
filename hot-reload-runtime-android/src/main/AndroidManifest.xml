<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The hot-reload runtime connects to the orchestration server over a TCP socket (reached on
      device via `adb reverse`). Declaring INTERNET here merges it into every consuming app so the
      dev runtime can open that socket. This is a dev-only runtime; it is not shipped to production.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
          Self-initializing bootstrap: a ContentProvider is created before any Activity, so it can
          attach the JVMTI agent and register an Activity lifecycle callback that reads the
          `orchestration_port` intent extra.
        -->
        <provider
            android:name="org.jetbrains.compose.reload.android.HotReloadInitProvider"
            android:authorities="${applicationId}.composeHotReloadInit"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
